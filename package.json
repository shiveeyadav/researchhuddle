  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "14.2.28",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
