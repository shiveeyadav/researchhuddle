# ---- ORCID (register a Public API client at https://orcid.org/developer-tools) ----
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=change-me
# "production" (orcid.org) or "sandbox" (sandbox.orcid.org)
ORCID_ENV=sandbox

# Public base URL of this app, no trailing slash. The ORCID redirect URI must be
# exactly APP_URL/api/auth/orcid/callback
APP_URL=http://localhost:3000

# ---- Database ----
# Set automatically by docker-compose from POSTGRES_PASSWORD; only needed outside Docker
# DATABASE_URL=postgres://researchhuddle:PASSWORD@localhost:5432/researchhuddle
# set to "true" if your managed Postgres requires TLS
DATABASE_SSL=false

# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-64-hex-chars

# Comma-separated ORCID iDs that get the admin/moderation page
ADMIN_ORCIDS=0000-0002-1825-0097

# ---- Mail (optional; with none set, emails are printed to the console) ----
MAIL_FROM=ResearchHuddle <no-reply@example.com>
# Option A: Resend
RESEND_API_KEY=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Bearer token for POST /api/cron/digest (weekly digest trigger)
CRON_SECRET=replace-with-random-string

# Port the app listens on inside the container
PORT=3000

# docker-compose only: Postgres password and host port the app is bound to (127.0.0.1)
# docker-compose: letters/digits only, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
# Host port (bound to 127.0.0.1; nginx proxies to it)
HOST_PORT=3040
